      "id": "0be44289-84a9-4f0c-a70a-4b9a789dbb5f",
      "name": "Run Partner Contract Check"
    },
    {
      "parameters": {
        "jsCode": "\nconst result = $input.first().json;\n\nlet readiness_decision;\nlet approval_required = false;\nlet reason;\n\nif (\n  result.verdict === \"PASS\" &&\n  result.http_status === 200\n) {\n  readiness_decision = \"PENDING_APPROVAL\";\n  approval_required = true;\n  reason = \"Contract validation passed. Human approval required.\";\n} else if (result.verdict === \"WARN\") {\n  readiness_decision = \"REVIEW\";\n  reason = \"Contract warnings require investigation before release.\";\n} else {\n  readiness_decision = \"NO_GO\";\n  reason = `Release blocked. Contract verdict: ${result.verdict ?? \"UNKNOWN\"}.`;\n}\n\nreturn [{\n  json: {\n    ...result,\n    readiness_decision,\n    approval_required,\n    reason,\n    assessed_at: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "eb5efe48-da72-49b9-96b8-f619a0877721",
      "name": "Assess Release Readiness"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "2c65298e-2247-41b2-8086-4edf46e0649d",
              "leftValue": "={{ $json.approval_required }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        896,
        0
      ],
      "id": "80638613-cd34-4c4c-bb90-923f3574b7b2",
      "name": "Approval Required?"
    },
    {
      "parameters": {
        "resume": "form",
        "formTitle": "Partner Release Approval",
        "formDescription": "=\n{{ 'Release: ' + $('Assess Release Readiness').first().json.release_id + ' | Partner: ' + $('Assess Release Readiness').first().json.connector_id + ' | Contract verdict: ' + $('Assess Release Readiness').first().json.verdict + ' | Records checked: ' + $('Assess Release Readiness').first().json.records_checked }}\n",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Decision",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Approve"
                  },
                  {
                    "option": "Reject"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Reviewer Name",
              "placeholder": "Enter reviewer name",
              "requiredField": true
            },
            {
              "fieldLabel": "Comments",
              "fieldType": "textarea",
              "placeholder": "Reason for approval or rejection"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1120,
        -96
      ],
      "id": "63e76576-78d9-49c3-84f3-6469f2d2dad7",
      "name": "Human Release Approval"
    },
    {
      "parameters": {
        "jsCode": "\nconst approval = $input.first().json;\nconst assessment = $('Assess Release Readiness').first().json;\n\nconst reviewer = String(approval[\"Reviewer Name\"] ?? \"\").trim();\nconst decision = approval.Decision;\n\nconst eligible =\n  assessment.verdict === \"PASS\" &&\n  assessment.http_status === 200 &&\n  assessment.readiness_decision === \"PENDING_APPROVAL\" &&\n  assessment.approval_required === true;\n\nconst approved =\n  eligible &&\n  decision === \"Approve\" &&\n  reviewer.length > 0;\n\nconst final_decision = approved ? \"GO\" : \"NO_GO\";\n\nlet reason;\n\nif (approved) {\n  reason = \"Contract passed and reviewer approved the release.\";\n} else if (!eligible) {\n  reason = \"Release is not eligible for approval.\";\n} else if (decision === \"Reject\") {\n  reason = \"Reviewer rejected the release.\";\n} else {\n  reason = \"Valid reviewer approval was not received.\";\n}\n\nreturn [{\n  json: {\n    ...assessment,\n    reviewer_name: reviewer,\n    reviewer_decision: decision ?? \"UNKNOWN\",\n    reviewer_comments: approval.Comments ?? \"\",\n    approval_submitted_at: approval.submittedAt ?? null,\n    final_decision,\n    final_reason: reason,\n    finalised_at: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -96
      ],
      "id": "6315d205-1f97-4c97-bb53-d20f43da87ed",
      "name": "Finalise Release Decision"
    },
    {
      "parameters": {
        "jsCode": "\nconst assessment = $input.first().json;\n\nconst final_decision =\n  assessment.readiness_decision === \"REVIEW\"\n    ? \"REVIEW\"\n    : \"NO_GO\";\n\nreturn [{\n  json: {\n    ...assessment,\n    reviewer_name: \"\",\n    reviewer_decision: \"NOT_REQUESTED\",\n    reviewer_comments: \"\",\n    approval_submitted_at: null,\n    final_decision,\n    final_reason: assessment.reason,\n    finalised_at: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
      ],
      "id": "0bb1d458-2f6c-41dd-b384-b7ddb8baa8ae",
