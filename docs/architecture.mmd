flowchart TB
  requester([Release requester]) --> R
  subgraph readiness["03 - Readiness Orchestrator"]
    R["Manual Release Request"] --> call["Call Workflow 2"]
    call --> decision{"Contract verdict?"}
    decision -->|"PASS, HTTP 200"| approval["Human approval form"]
    approval -->|"Approve + reviewer"| GO["GO"]
    approval -->|"Reject or invalid approval"| NOGO["NO_GO"]
    decision -->|WARN| REVIEW["REVIEW"]
    decision -->|"FAIL / ERROR / unknown"| NOGO
    GO --> audit["release_decision_audit"]
    NOGO --> audit
    REVIEW --> audit
  end
  subgraph checker["02 - Partner Contract Checker"]
    http["HTTP Request with Header Auth"] --> retry{"429 or 503 and attempts left?"}
    retry -->|Yes| wait["Wait 2 seconds"]
    wait --> http
    retry -->|No| validate["Validate contract"]
    validate --> results["contract_test_results"]
  end
  subgraph mock["01 - Mock Partner API"]
    webhook["Authenticated webhook"] --> synth["Synthetic API responses"]
    synth --> response["HTTP 200 / 429 / 503"]
  end
  subgraph handler["04 - Central Error Handler"]
    trigger["Error Trigger"] --> log["workflow_error_audit"]
  end
  call -. "invoke" .-> http
  http -. "GET /webhook/partner-alpha/customers" .-> webhook
  results -. "return result" .-> call
  synth -. "unexpected execution failure" .-> trigger
