      ],
      "id": "cfa4a57c-5693-4f43-8ef5-b02794b8e905",
      "name": "Capture Workflow Failure"
    },
    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\n\nconst workflow = input.workflow ?? {};\nconst execution = input.execution ?? {};\nconst trigger = input.trigger ?? {};\n\nconst error = execution.error ?? trigger.error ?? {};\n\nconst errorMessage =\n  error.message ??\n  error.cause?.message ??\n  \"Unknown workflow error\";\n\nreturn [{\n  json: {\n    workflow_name: String(workflow.name ?? \"Unknown\"),\n    workflow_id: String(workflow.id ?? \"\"),\n    execution_id: String(execution.id ?? \"\"),\n    failed_node: String(\n      execution.lastNodeExecuted ??\n      trigger.error?.node?.name ??\n      \"Unknown\"\n    ),\n    error_message: String(errorMessage),\n    execution_url: String(execution.url ?? \"\"),\n    error_type: String(\n      error.name ??\n      (trigger.error ? \"TriggerFailure\" : \"ExecutionFailure\")\n    ),\n    occurred_at: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "e842ab05-9586-4a82-974e-3c4dbcf577b9",
