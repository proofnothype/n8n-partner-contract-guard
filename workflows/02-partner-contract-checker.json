      "id": "02e956fc-b402-4c92-b98a-35ac71b69fc4",
      "name": "Wait Before Retry"
    },
    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\n\n// HTTP Request has \"Include Response Headers and Status\" enabled.\nconst statusCode = response.statusCode;\n\nif (statusCode !== 200) {\n  const isAuthError =\n    statusCode === 401 || statusCode === 403;\n\n  const message = isAuthError\n    ? `API authentication failed (HTTP ${statusCode})`\n    : `API request failed (HTTP ${statusCode ?? \"unknown\"})`;\n\n  return [{\n    json: {\n      scenario: isAuthError ? \"auth_missing\" : \"http_error\",\n      http_status: statusCode ?? null,\n      verdict: \"ERROR\",\n      records_checked: 0,\n      errors: [message],\n      warnings: []\n    }\n  }];\n}\n\nlet data = response.body ?? response;\n\nif (typeof data === \"string\") {\n  data = JSON.parse(data);\n}\n\nconst errors = [];\nconst warnings = [];\n\n// Our agreed v1 contract. These fields must exist.\nconst expectedFields = {\n  customer_id: \"string\",\n  email: \"string\",\n  credit_limit: \"number\",\n  updated_at: \"string\"\n};\n\n// Check HTTP status.\nif (statusCode !== 200) {\n  errors.push(`Unexpected HTTP status: ${statusCode}`);\n}\n\n// Check response envelope.\nif (!Array.isArray(data.items)) {\n  errors.push(\"items must be an array\");\n} else {\n  // Our mock returns all records in one response.\n  if (data.total_count !== data.items.length) {\n    errors.push(\n      `Record count mismatch: expected ${data.total_count}, received ${data.items.length}`\n    );\n  }\n\n  // Check each customer record.\n  data.items.forEach((customer, index) => {\n    for (const [field, type] of Object.entries(expectedFields)) {\n      if (!(field in customer)) {\n        errors.push(`Record ${index + 1}: missing ${field}`);\n      } else if (customer[field] === null) {\n        errors.push(`Record ${index + 1}: ${field} is null`);\n      } else if (typeof customer[field] !== type) {\n        errors.push(`Record ${index + 1}: ${field} should be ${type}`);\n      }\n    }\n\n    for (const field of Object.keys(customer)) {\n      if (!(field in expectedFields)) {\n        const message = `Unexpected optional field: ${field}`;\n        if (!warnings.includes(message)) warnings.push(message);\n      }\n    }\n  });\n}\n\n// Determine the result.\nconst verdict = errors.length > 0\n  ? \"FAIL\"\n  : warnings.length > 0\n    ? \"WARN\"\n    : \"PASS\";\n\nreturn [{\n  json: {\n    scenario: data.scenario,\n    http_status: statusCode,\n    verdict,\n    records_checked: Array.isArray(data.items) ? data.items.length : 0,\n    errors,\n    warnings\n  }\n}];\n"
      },
